# The local target's fixture for scripts/check-deploy.mjs (E7 design 1.4; E7D-C-F12's synthetic-fixture exception).
# Every value here is a PLACEHOLDER and none is a credential: this file is committed, it is the one env file the
# script's in-tree refusal admits, and scripts/check-secrets.mjs is what keeps it free of a secret-shaped value.
# It is not the local stack's own environment. tests/e2/helpers/stack.mjs reads that from `supabase status` into
# process.env; this file exists so the deploy check has a known-good fact set to run clean against in
# scripts/check.sh, and so every one of E7-18's cases can be built by changing exactly one line of it.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=placeholder-local-publishable-key
SUPABASE_JWT_SECRET=example-unit-secret-with-at-least-32-characters-long
ENTERPRISE_SERVER_SIGNING_ALG=HS256
ENTERPRISE_ORIGIN=http://127.0.0.1:3000
ENTERPRISE_ACCESS_STATE=open
ENTERPRISE_INVITATION_DELIVERY=handover
ENTERPRISE_ALERT_SINK=none
